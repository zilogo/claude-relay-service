# 🚀 Claude Relay Service Configuration

# 🌐 服务器配置
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
TRUST_PROXY=true

# 🔐 安全配置
JWT_SECRET=change-me-in-production
ADMIN_SESSION_TIMEOUT=86400000
API_KEY_PREFIX=cr_
ENCRYPTION_KEY=change-this-32-character-key

# 👤 管理员凭据（可选，不设置则自动生成）
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 📊 Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLE_TLS=

# 🔗 会话管理配置
STICKY_SESSION_TTL_HOURS=1
STICKY_SESSION_RENEWAL_THRESHOLD_MINUTES=15

# 🎯 Claude API 配置
CLAUDE_API_URL=https://api.anthropic.com/v1/messages
CLAUDE_API_VERSION=2023-06-01
CLAUDE_BETA_HEADER=claude-code-20250219,oauth-2025-04-20,interleaved-thinking-2025-05-14,fine-grained-tool-streaming-2025-05-14
CLAUDE_OVERLOAD_HANDLING_MINUTES=0
CLAUDE_CONSOLE_BLOCKED_HANDLING_MINUTES=10
CLAUDE_5H_WARNING_MAX_NOTIFICATIONS=5

# ☁️ Claude Code / Bedrock 配置
CLAUDE_CODE_USE_BEDROCK=0
AWS_REGION=us-east-1
ANTHROPIC_SMALL_FAST_MODEL_AWS_REGION=
ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0
ANTHROPIC_SMALL_FAST_MODEL=us.anthropic.claude-3-5-haiku-20241022-v1:0
CLAUDE_CODE_MAX_OUTPUT_TOKENS=4096
MAX_THINKING_TOKENS=1024
DISABLE_PROMPT_CACHING=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 🌐 代理与请求配置
DEFAULT_PROXY_TIMEOUT=600000
MAX_PROXY_RETRIES=3
PROXY_USE_IPV4=true
REQUEST_TIMEOUT=600000
DEFAULT_TOKEN_LIMIT=1000000
DEBUG_HTTP_TRAFFIC=false

# 📝 日志与系统配置
LOG_LEVEL=info
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
CLEANUP_INTERVAL=3600000
TOKEN_USAGE_RETENTION=2592000000
HEALTH_CHECK_INTERVAL=60000
SYSTEM_TIMEZONE=Asia/Shanghai
TIMEZONE_OFFSET=8
METRICS_WINDOW=5
SYSTEM_PROMPT_THRESHOLD=0.5
BILLING_EVENTS_ENABLED=true
APP_VERSION=
VERSION=

# 🎨 Web 界面配置
WEB_TITLE=AI TokenCloud
WEB_DESCRIPTION=Multi-account Claude API relay service with beautiful management interface
WEB_LOGO_URL=/assets/logo.png
WEB_SESSION_SECRET=change-this-session-secret
ENABLE_CORS=true
BASE_URL=http://localhost:3000

# 🛠️ 开发/调试配置
DEBUG=false
HOT_RELOAD=false
HTTP_PROXY=
HTTPS_PROXY=

# 🔐 LDAP 认证配置
LDAP_ENABLED=false
LDAP_URL=ldaps://ldap.example.com:636
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=admin_password
LDAP_SEARCH_BASE=dc=example,dc=com
LDAP_SEARCH_FILTER=(uid={{username}})
LDAP_SEARCH_ATTRIBUTES=dn,uid,cn,mail,givenName,sn
LDAP_TIMEOUT=5000
LDAP_CONNECT_TIMEOUT=10000
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_TLS_CA_FILE=
LDAP_TLS_CERT_FILE=
LDAP_TLS_KEY_FILE=
LDAP_TLS_SERVERNAME=
LDAP_USER_ATTR_USERNAME=uid
LDAP_USER_ATTR_DISPLAY_NAME=cn
LDAP_USER_ATTR_EMAIL=mail
LDAP_USER_ATTR_FIRST_NAME=givenName
LDAP_USER_ATTR_LAST_NAME=sn

# 👥 用户与认证配置
USER_MANAGEMENT_ENABLED=true
DEFAULT_USER_ROLE=user
USER_SESSION_TIMEOUT=86400000
MAX_API_KEYS_PER_USER=1
ALLOW_USER_DELETE_API_KEYS=false
LOCAL_AUTH_ENABLED=true
ALLOW_SELF_REGISTRATION=true
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
REQUIRE_PASSWORD_CHANGE=false

# 📧 邮件服务配置
EMAIL_ENABLED=true
EMAIL_SERVICE_TYPE=smtp
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Claude Relay Service
EMAIL_FROM_ADDRESS=noreply@example.com
REQUIRE_EMAIL_VERIFICATION=false
ALLOW_PASSWORD_RESET=true
EMAIL_RATE_LIMIT_WINDOW=600
EMAIL_RATE_LIMIT_MAX=3
EMAIL_VERIFICATION_TOKEN_TTL=86400
PASSWORD_RESET_TOKEN_TTL=3600

# ==================== 💰 支付系统配置 ====================
PAYMENT_ENABLED=true
PAYMENT_MIN_AMOUNT=0.001            # 兼容旧变量 RECHARGE_MIN_AMOUNT
PAYMENT_MAX_AMOUNT=1000             # 兼容旧变量 RECHARGE_MAX_AMOUNT
PAYMENT_ALLOW_CUSTOM_AMOUNT=true    # 兼容新变量 ALLOW_CUSTOM_AMOUNT
PAYMENT_DEFAULT_CURRENCY=CNY        # 兼容新变量 DEFAULT_CURRENCY
PAYMENT_EXCHANGE_RATE=7.2           # 兼容新变量 EXCHANGE_RATE
PAYMENT_ORDER_EXPIRE_MINUTES=30     # 兼容旧变量 ZPAY_ORDER_EXPIRE_MINUTES
MAX_ORDERS_PER_MINUTE=3
PAYMENT_PACKAGES=[]                 # JSON 数组，如 [{"id":"pkg_10","amount":10,"currency":"USD"}]

# ==================== ZPAY 配置 ====================
ZPAY_ENABLED=true
ZPAY_PID=
ZPAY_KEY=
ZPAY_API_URL=https://zpayz.cn
ZPAY_SUBMIT_URL=https://zpayz.cn/submit.php
ZPAY_QUERY_URL=https://zpayz.cn/api.php
ZPAY_PAYMENT_METHODS=alipay,wxpay
ZPAY_ORDER_PREFIX=ORD_
ZPAY_NOTIFY_URL=
ZPAY_RETURN_URL=
ZPAY_NOTIFY_USER=false
ZPAY_IP_WHITELIST=
ZPAY_REQUIRE_HTTPS=true

# 📢 Webhook 配置
WEBHOOK_ENABLED=true
WEBHOOK_URLS=
WEBHOOK_TIMEOUT=10000
WEBHOOK_RETRIES=3

# 📊 价格镜像数据配置
PRICE_MIRROR_REPO=Wei-Shaw/claude-relay-service
PRICE_MIRROR_BRANCH=price-mirror
PRICE_MIRROR_FILENAME=model_prices_and_context_window.json
PRICE_MIRROR_HASH_FILENAME=model_prices_and_context_window.sha256
PRICE_MIRROR_BASE_URL=
PRICE_MIRROR_JSON_URL=
PRICE_MIRROR_HASH_URL=
GITHUB_REPOSITORY=

# 🤖 其他集成
GOOGLE_CLOUD_PROJECT=
